modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

# Ensure browsers always revalidate the HTML entry point after a redeploy.
# JS/CSS bundles have content-hash filenames so they can be cached long-term;
# only index.html (and paths that serve it via SPA rewrites) needs no-cache.
[[deployment.responseHeaders]]
path = "/*.html"
name = "Cache-Control"
value = "no-cache"

# The SPA root paths (/, /mobile/, etc.) are rewritten to index.html by Replit
# but the request path itself ends without .html — cover those explicitly.
[[deployment.responseHeaders]]
path = "/"
name = "Cache-Control"
value = "no-cache"

[[deployment.responseHeaders]]
path = "/mobile/"
name = "Cache-Control"
value = "no-cache"

[[deployment.responseHeaders]]
path = "/production-booking/"
name = "Cache-Control"
value = "no-cache"

[[deployment.responseHeaders]]
path = "/new-booking-schedule/"
name = "Cache-Control"
value = "no-cache"

# Hashed JS/CSS/font assets can be cached indefinitely — their filenames change
# on every build so stale content is never served.
[[deployment.responseHeaders]]
path = "/assets/*"
name = "Cache-Control"
value = "public, max-age=31536000, immutable"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow]]
name = "test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm -r --if-present run test"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
AZURE_PG_HOST = "fs-postgresql-prod.postgres.database.azure.com"
AZURE_PG_DATABASE = "d365crm"
AZURE_PG_SCHEMA = "d365fo"
AZURE_PG_PORT = "5432"
AZURE_PG_SP_USER = "crmadmin"
AZURE_PG_SSLMODE = "require"
D365_URL = "https://toprod.operations.dynamics.com"

[nix]
channel = "stable-25_05"
